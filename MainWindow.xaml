<Window x:Class="HWWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HW Widget"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#01000000"
        Width="360" Height="170" MinWidth="140" MinHeight="70"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
  <Border x:Name="Root" CornerRadius="12" Padding="12,10" BorderThickness="1"
          Background="Transparent" MouseLeftButtonDown="Root_MouseLeftButtonDown">
    <ContentControl x:Name="Host" />
  </Border>
</Window>
